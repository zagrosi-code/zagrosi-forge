{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zagrosi.dev/schemas/vendor-receipt-v1",
  "title": "Zagrosi Forge Vendor Receipt v1",
  "type": "object",
  "required": ["schema_version", "schema_digest", "writer_version", "minimum_reader_version", "record_digest", "limit_policy_version", "upstream", "selected_files", "license"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_version": {"type": "string"},
    "minimum_reader_version": {"type": "string"},
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limit_policy_version": {"const": "1.0"},
    "upstream": {"type": "object"},
    "selected_files": {"type": "array", "items": {"type": "object"}},
    "license": {"type": "object"}
  },
  "additionalProperties": true,
  "x-limit-policy-version": "1.0"
}
