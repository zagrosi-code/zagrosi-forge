{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zagrosi.dev/schemas/bundle-manifest-v1",
  "title": "Zagrosi Forge Bundle Manifest v1",
  "type": "object",
  "required": ["schema_version", "base_version", "policy_digest", "entries", "aggregate_size", "payload_digest", "builder_version", "normalization_profile"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "base_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "file_type", "mode", "size", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "file_type": {"const": "regular"},
          "mode": {"enum": [420, 493]},
          "size": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "aggregate_size": {"type": "integer", "minimum": 0},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "builder_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "normalization_profile": {"const": "bundle-v1"}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "allOf": [
        {"pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)~)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]*[. ](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Ll][Oo][Cc][Kk]\\$|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*|/|$))[^\\u0000-\\u001f\\u007f]+$"},
        {"pattern": "^[^/]{1,63}(?:/[^/]{1,63}){0,15}$"}
      ]
    }
  },
  "additionalProperties": false,
  "x-limit-policy-version": "1.0"
}
